[Unit]
Description=Monitor CandleScope query backup success cadence
After=network-online.target candlescope-query-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=candlescope-backup
Group=candlescope-backup
WorkingDirectory=/opt/candlescope
EnvironmentFile=/etc/candlescope/query-backup-monitor.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env /opt/candlescope/backend/.venv/bin/python /opt/candlescope/backend/scripts/server_query_backup_monitor.py
TimeoutStartSec=2min
StateDirectory=candlescope-query-backup-history
StateDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=candlescope-query-backup-monitor
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
