[Unit]
Description=CandleScope query-control physical backup
After=network-online.target
Wants=network-online.target
OnFailure=candlescope-query-backup-failure@%n.service

[Service]
Type=oneshot
User=candlescope-backup
Group=candlescope-backup
WorkingDirectory=/opt/candlescope
EnvironmentFile=/etc/candlescope/query-backup.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env /opt/candlescope/backend/.venv/bin/python /opt/candlescope/backend/scripts/server_query_backup_job.py
TimeoutStartSec=25min
RuntimeDirectory=candlescope-query-backup
RuntimeDirectoryMode=0700
StateDirectory=candlescope-query-backup
StateDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=candlescope-query-backup
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
