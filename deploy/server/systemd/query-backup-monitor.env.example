# Install as /etc/candlescope/query-backup-monitor.env with owner root,
# group candlescope-backup, mode 0640. Replace every placeholder.

CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_INVENTORY_ROOT=/var/lib/candlescope-query-backup-history
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_CLUSTER_ID=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_LOOKBACK_MS=259200000
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_MAXIMUM_INVENTORY_FILES=4096
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_MAXIMUM_REFERENCE_BYTES=16384
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_MAXIMUM_HISTORIES=64
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_MAXIMUM_GAP_MS=108000000
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_MAXIMUM_FUTURE_SKEW_MS=300000
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_ALERT_WEBHOOK_URL=https://replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_ALERT_HMAC_KEY_ID=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_ALERT_HMAC_SECRET_BASE64=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_ALERT_TIMEOUT_MS=10000
CANDLESCOPE_SERVER_QUERY_BACKUP_MONITOR_MAXIMUM_ALERT_RESPONSE_BYTES=4096

# Use a dedicated read-only history identity: GetObject on the fixed history
# prefix only. Do not grant list, put, overwrite, or delete.
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_S3_ENDPOINT_URL=https://replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_S3_REGION=us-east-1
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_S3_BUCKET=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_S3_PREFIX=query-operations
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_S3_ACCESS_KEY_ID=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_S3_SECRET_ACCESS_KEY=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_HMAC_KEY_ID=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_HMAC_SECRET_BASE64=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_CLUSTER_ID=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_HISTORY_REQUEST_TIMEOUT_MS=30000
