# Install as /etc/candlescope/query-backup.env with owner root,
# group candlescope-backup, mode 0640. Replace every placeholder.

CANDLESCOPE_SERVER_QUERY_BACKUP_JOB_STAGING_ROOT=/var/lib/candlescope-query-backup
CANDLESCOPE_SERVER_QUERY_BACKUP_JOB_LOCK_PATH=/run/candlescope-query-backup/job.lock
CANDLESCOPE_SERVER_QUERY_BACKUP_JOB_PG_BASEBACKUP_EXECUTABLE=/usr/lib/postgresql/18/bin/pg_basebackup
CANDLESCOPE_SERVER_QUERY_BACKUP_JOB_BASEBACKUP_TIMEOUT_MS=900000
CANDLESCOPE_SERVER_QUERY_BACKUP_JOB_WINDOW_TIMEOUT_MS=360000
CANDLESCOPE_SERVER_QUERY_BACKUP_JOB_MAX_CHILD_OUTPUT_BYTES=1048576

CANDLESCOPE_SERVER_QUERY_BACKUP_SELECT_MAXIMUM_CANDIDATES=32
CANDLESCOPE_SERVER_QUERY_BACKUP_SELECT_MAXIMUM_RECEIPT_BYTES=65536
CANDLESCOPE_SERVER_QUERY_BACKUP_SELECT_MAXIMUM_AGE_MS=108000000
CANDLESCOPE_SERVER_QUERY_BACKUP_SELECT_MAXIMUM_FUTURE_SKEW_MS=300000

PGHOST=replace-me
PGPORT=5432
PGDATABASE=candlescope
PGUSER=candlescope_backup
PGPASSFILE=/etc/candlescope/query-backup.pgpass

CANDLESCOPE_SERVER_QUERY_BACKUP_WINDOW_POSTGRES_AUDITOR_DSN=postgresql://replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_WINDOW_OPERATOR_ID=scheduled-backup
CANDLESCOPE_SERVER_QUERY_BACKUP_WINDOW_CONNECT_TIMEOUT_MS=5000
CANDLESCOPE_SERVER_QUERY_BACKUP_WINDOW_DRAIN_TIMEOUT_MS=30000
CANDLESCOPE_SERVER_QUERY_BACKUP_WINDOW_MAXIMUM_RUNTIME_MS=300000
CANDLESCOPE_SERVER_QUERY_BACKUP_WINDOW_HEARTBEAT_INTERVAL_MS=500

CANDLESCOPE_SERVER_QUERY_AUDIT_ANCHOR_POSTGRES_DSN=postgresql://replace-me
CANDLESCOPE_SERVER_QUERY_AUDIT_ANCHOR_S3_ENDPOINT_URL=https://replace-me
CANDLESCOPE_SERVER_QUERY_AUDIT_ANCHOR_S3_REGION=us-east-1
CANDLESCOPE_SERVER_QUERY_AUDIT_ANCHOR_S3_BUCKET=replace-me
CANDLESCOPE_SERVER_QUERY_AUDIT_ANCHOR_S3_PREFIX=query-operations
CANDLESCOPE_SERVER_QUERY_AUDIT_ANCHOR_S3_ACCESS_KEY_ID=replace-me
CANDLESCOPE_SERVER_QUERY_AUDIT_ANCHOR_S3_SECRET_ACCESS_KEY=replace-me
CANDLESCOPE_SERVER_QUERY_AUDIT_ANCHOR_HMAC_KEY_ID=replace-me
CANDLESCOPE_SERVER_QUERY_AUDIT_ANCHOR_HMAC_SECRET_BASE64=replace-me

CANDLESCOPE_SERVER_QUERY_BACKUP_POSTGRES_AUDITOR_DSN=postgresql://replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_PG_VERIFYBACKUP_EXECUTABLE=/usr/bin/pg_verifybackup
CANDLESCOPE_SERVER_QUERY_BACKUP_CLUSTER_ID=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_POSTGRES_VERSION=18.4
CANDLESCOPE_SERVER_QUERY_BACKUP_WAL_ARCHIVE_PREFIX_URI=s3://replace-me/query-operations/wal/v1/replace-me/
CANDLESCOPE_SERVER_QUERY_BACKUP_S3_ENDPOINT_URL=https://replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_S3_REGION=us-east-1
CANDLESCOPE_SERVER_QUERY_BACKUP_S3_BUCKET=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_S3_PREFIX=query-operations
CANDLESCOPE_SERVER_QUERY_BACKUP_S3_ACCESS_KEY_ID=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_S3_SECRET_ACCESS_KEY=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_BACKUP_HMAC_KEY_ID=replace-me
CANDLESCOPE_SERVER_QUERY_BACKUP_BACKUP_HMAC_SECRET_BASE64=replace-me

CANDLESCOPE_SERVER_QUERY_WAL_S3_ENDPOINT_URL=https://replace-me
CANDLESCOPE_SERVER_QUERY_WAL_S3_REGION=us-east-1
CANDLESCOPE_SERVER_QUERY_WAL_S3_BUCKET=replace-me
CANDLESCOPE_SERVER_QUERY_WAL_S3_PREFIX=query-operations
CANDLESCOPE_SERVER_QUERY_WAL_S3_ACCESS_KEY_ID=replace-me
CANDLESCOPE_SERVER_QUERY_WAL_S3_SECRET_ACCESS_KEY=replace-me
CANDLESCOPE_SERVER_QUERY_WAL_CLUSTER_ID=replace-me
