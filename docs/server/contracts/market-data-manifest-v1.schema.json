{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://candlescope.dev/contracts/market-data-manifest-v1.schema.json",
  "title": "CandleScope MarketDataManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_epoch",
    "snapshot_version",
    "parent_snapshot",
    "segment"
  ],
  "properties": {
    "schema_version": {"const": "market-data-manifest.v1"},
    "data_epoch": {"type": "string", "minLength": 1},
    "snapshot_version": {"type": "integer", "minimum": 1},
    "parent_snapshot": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/snapshot"}
      ]
    },
    "segment": {"$ref": "#/$defs/segment"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_epoch",
        "snapshot_version",
        "manifest_uri",
        "manifest_sha256"
      ],
      "properties": {
        "data_epoch": {"type": "string", "minLength": 1},
        "snapshot_version": {"type": "integer", "minimum": 1},
        "manifest_uri": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_uri",
        "content_sha256",
        "byte_size",
        "format",
        "parquet_schema_version",
        "parquet_schema_sha256",
        "row_count",
        "partition_key",
        "kafka_topic",
        "kafka_partition",
        "first_kafka_offset",
        "last_kafka_offset",
        "start_event_time_ms",
        "end_event_time_ms",
        "sequence_start",
        "sequence_end",
        "envelope_sha256s"
      ],
      "properties": {
        "object_uri": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1},
        "format": {"const": "parquet"},
        "parquet_schema_version": {"const": "market-event-parquet.v1"},
        "parquet_schema_sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 1},
        "partition_key": {"type": "string", "minLength": 1},
        "kafka_topic": {"type": "string", "minLength": 1},
        "kafka_partition": {"type": "integer", "minimum": 0},
        "first_kafka_offset": {"type": "integer", "minimum": 0},
        "last_kafka_offset": {"type": "integer", "minimum": 0},
        "start_event_time_ms": {"type": "integer", "minimum": 0},
        "end_event_time_ms": {"type": "integer", "minimum": 0},
        "sequence_start": {"type": ["integer", "null"], "minimum": 0},
        "sequence_end": {"type": ["integer", "null"], "minimum": 0},
        "envelope_sha256s": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
